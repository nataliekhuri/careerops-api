# CareerOps API - example settings
# Copy this file to .env and fill in the real password.
# Never commit .env (it is already listed in .gitignore).

DB_HOST=localhost
DB_PORT=5433
DB_NAME=careerops
DB_USER=careerops_user
DB_PASSWORD=change-me

# Optional: seconds to wait for a database connection (default 5)
# DB_CONNECT_TIMEOUT=5

# Alternative to the DB_* values above (used by hosting platforms such as Render):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Required: secret that signs login tokens (at least 32 characters). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-value-at-least-32-chars

# Optional: login token lifetime in minutes (default 60)
# ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional: browser origins allowed to call the API, comma-separated (e.g. the frontend)
# CORS_ORIGINS=http://localhost:5173

# Optional: AI assistant provider. Only "builtin" exists (free, runs locally, no API key).
# AI_PROVIDER=builtin
